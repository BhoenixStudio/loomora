{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "loomora",
  "version": "0.1.0",
  "description": "Composable React inputs, UI components, hooks, and shared defaults for product teams.",
  "keywords": [
    "react",
    "nextjs",
    "typescript",
    "components",
    "form",
    "inputs",
    "hooks",
    "ui",
    "accessibility",
    "design-system",
    "utilities"
  ],
  "homepage": "https://www.npmjs.com/package/loomora",
  "bugs": {
    "url": "https://github.com/REPLACE_WITH_YOUR_USERNAME/loomora/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REPLACE_WITH_YOUR_USERNAME/loomora.git"
  },
  "license": "MIT",
  "author": "Bhoenix Studio",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "playground"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build && npm run pack:dry",
    "check:playground": "npm run typecheck --workspace playground && npm run lint --workspace playground && npm run build --workspace playground",
    "dev": "concurrently --kill-others-on-fail --names library,playground \"npm run build:watch\" \"npm run dev:playground\"",
    "dev:playground": "npm run dev --workspace playground",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm run check",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
